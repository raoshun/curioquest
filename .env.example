# CurioQuest 環境変数テンプレ
# docker compose は同名の環境変数をこのファイル経由でコンテナへ渡す。
# バックエンドは「接続設定の解決のみ起動時、実際の接続は初回リクエスト時」に行う。
# 値を置かなくても（LOCAL LLM が無くても）サーバー起動与会話テキスト往復は可能。

# --- LLM（OpenAI 互換 /v1 ルートの base URL を指定） ---
# ローカル vLLM / Ollama / llama.cpp 等何でも可。未設定なら設定デフォルト:
# http://localhost:11434/v1（コンテナからは届かないため、compose では
# host.docker.internal:11434/v1 をデフォルトにしている）
CURIOQUEST_LLM_BASE_URL=http://localhost:11434/v1
CURIOQUEST_LLM_MODEL=qwen2.5
# server に鍵を要求する構成のときだけ設定する（空だと Authorization ヘッダ無し）
# CURIOQUEST_LLM_API_KEY=

# --- LLM モデル選択（生成温度・トークン上限・生成数） ---
# 温度は低いほど堅い受け応えに、高いほど変化が出る。公式 vLLM 等は n>1 で
# beam search 互換モードになり temperature が無視され得るため、まず 1.0 のまま
# 応答品質を見て必要なら下げる。max_tokens は 1 応答あたり（8192 が設定デフォルト。
# 32768 は 8B クラスの長い独り言ループまで出力し得るため実用に合わせた値へ）。
# n はバッチ生成数で、合成音声で 1 つ選ぶ使い方を想定し 2 をデフォルトに
# （vLLM 側 --max-num-seqs は 4 推奨。環境変数にしない設定は engine/config.py を参照）。
# 生成ごとに KV キャッシュ分まで見込んで VRAM を使うため、VRAM が少ない環境では
# Ollama 等が 500 (CUDA out of memory) を返すことがある。その場合は 1 に下げる。
CURIOQUEST_LLM_TEMPERATURE=1.0
CURIOQUEST_LLM_MAX_TOKENS=8192
CURIOQUEST_LLM_NUM_COMPLETIONS=2

# --- VOICEVOX Engine（TTS）---
# compose 内サービス名で解決できるようにしてある。設定デフォルト:
# http://localhost:50021
CURIOQUEST_VOICEVOX_BASE_URL=http://voicevox:50021
# 0 はずんだもん。17 はオリーブちゃん（マリンちゃん 18 / つたくん 26）だが、
# engine/config.py の既定キャラ（44 系で整えた構成）を推奨。
# 子別の話者割当はキャラクター定義（DB の speaker_id）が先で、この値は
# キャラ設定が無い場合のフォールバックにのみ使われる。
CURIOQUEST_VOICEVOX_DEFAULT_SPEAKER=17

# --- STT（バックエンドプロセス内で動かす faster-whisper）---
# tiny / base / small / medium / large-v3 など（設定デフォルト: small）。
# CPU でも動くのは tiny〜small あたりまで。large-v3 は 3073 と異なり
# GPU なしでは実用にならない傾向（large の 1265 と比較）。
CURIOQUEST_STT_MODEL=small

# --- サーバー（コンテナ内は compose が 0.0.0.0:8000 に固定するため通常変更不要） ---
# CURIOQUEST_HOST / CURIOQUEST_PORT はモノリス（curioquest-api）を直接起動するときだけ効く。
# compose でホスト側の公開ポートを変えたい場合は下の CQ_HOST_PORT を使うこと。
# CURIOQUEST_HOST=127.0.0.1
# CURIOQUEST_PORT=8000

# --- Docker Compose のホスト公開ポート（既定 8000。競合時のみ変更） ---
# CQ_HOST_PORT=8080

# --- 容器内のタイムゾーン（日誌と日次クエストの日付境界の基準。既定 Asia/Tokyo） ---
# CQ_TZ=Asia/Tokyo

# --- データベース（コンテナ内パス。/data は named volume） ---
# CURIOQUEST_DB_PATH=/data/curioquest.db

# --- バックアップ（Phase 5 家庭内実運用。compose の backup サービスが読んだ分だけ実行） ---
# 実行間隔の秒数。既定 86400（1日1回）。1回だけ試したいときは本体コンテナで
# `curioquest-backup` を --interval なしで実行する。
# CQ_BACKUP_INTERVAL_SECONDS=86400
# 保持する世代数。古いアーカイブから自動削除される。0 以下で無制限。
# CQ_BACKUP_KEEP=7
